    },
    "This permanently deletes every message stored on this device. Your chats stay in the list, but the messages inside them will be gone.\n\nOnym keeps no copy on its servers, and messages can’t be re-downloaded — relay copies are best-effort and may already have expired.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes every message stored on this device. Your chats stay in the list, but the messages inside them will be gone.\n\nOnym keeps no copy on its servers, and messages can’t be re-downloaded — relay copies are best-effort and may already have expired."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит все сообщения, хранящиеся на этом устройстве. Ваши чаты останутся в списке, но сообщения внутри них будут удалены.\n\nOnym не хранит копий на своих серверах, и сообщения нельзя загрузить заново — копии на релеях в лучшем случае временны и, возможно, уже удалены."
          }
        }
      }
    },
    "This removes %@ and every message in it from this device. It can't be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes %@ and every message in it from this device. It can't be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит %@ и все сообщения в нём с этого устройства. Отменить будет нельзя."
          }
        }
      }
    },
