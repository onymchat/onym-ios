        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Казна — это аккаунт Stellar, тратить из которого можно только по согласию нескольких участников чата."
          }
        }
      }
    },
    "A treasury is controlled by a set of Stellar accounts. Tell %@ which one is yours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
