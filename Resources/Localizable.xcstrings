        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти 12 слов — единственный способ вернуть доступ к аккаунту, если вы потеряете этот iPhone. Onym не сможет их сбросить."
          }
        }
      }
    },
    "These rules were read and signed with this identity’s key before joining.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rules were read and signed with this identity’s key before joining."
          }
        },
        "ru": {
          "stringUnit": {
