          }
        }
      }
    },
    "These rules were set for the group by this member. Founders don’t sign their own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rules were set for the group by this member. Founders don’t sign their own."
