    },
    "These 12 words are the only way back into your account if you lose this iPhone. Onym cannot reset them for you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These 12 words are the only way back into your account if you lose this iPhone. Onym cannot reset them for you."
          }
